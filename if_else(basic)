# 4. Take marks. Print grade using nested if-else.
marks = int(input('Enter your Marks out of 100: '))
if 100 >= marks >= 0:
    if marks >= 91:
        print(f'A+ Grade ({marks}/100)')
    elif marks >= 81:
        print(f'A Grade ({marks}/100)')
    elif marks >= 71:
        print(f'B+ Grade ({marks}/100)')
    elif marks >= 61:
        print(f'B Grade ({marks}/100)')
    elif marks >= 51:
        print(f'C+ Grade ({marks}/100)')
    elif marks >= 41:
        print(f'C Grade ({marks}/100)')
    elif marks >= 35:
        print(f'D Grade ({marks}/100)')
    else:
        print(f'Fail ({marks}/100). Try harder!')
else:
    print('Enter valid marks out of 100')
# 5. Take a year. Check leap year.
year=int(input('Enter a year :'))
if 9999>= year >= 1:
    if year%100 == 0:
        if  year%400 == 0:
            print('This is a leap year', year)
        else:
            print('This is not a leap year.',year)
    else :
        if year%4==0:
            print('This is a leap year',year)

        else :
            print('This is not a leap Year',year)
else:
    print('Enter a valid year.')

# 6. Take a character. Check vowel and consonant.
char = input('Enter any word or character: ')
vowel = 'aeiouAEIOU'
i = j = 0
for c in char:
    if c.isalpha():
        if c in vowel:
            i += 1
        else:
            j += 1
print('vowels =', i)
print('consonants =', j)
    
